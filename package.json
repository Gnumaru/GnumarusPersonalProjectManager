{
  "name": "gnumarus-project-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "e2e": "bash scripts/e2e-smoke.sh",
    "e2e:browser": "node scripts/e2e-browser.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e && npm run e2e:browser",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "jsdom": "~30.1.2",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
